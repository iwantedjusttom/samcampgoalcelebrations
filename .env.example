# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: image model to use (default: gpt-image-1)
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional but strongly recommended once deployed: a password the app asks for,
# so nobody who stumbles on the URL can spend your OpenAI credits.
APP_PASSWORD=
