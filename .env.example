# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: image model(s) to try first, comma-separated. If unset the app tries
# gpt-image-2.5-sunburst, then gpt-image-2.5-flare, then gpt-image-2.
OPENAI_IMAGE_MODEL=

# Optional but strongly recommended once deployed: a password the app asks for,
# so nobody who stumbles on the URL can spend your OpenAI credits.
APP_PASSWORD=

# Optional: text model(s) for "Suggest Direction", comma-separated. If unset the
# app tries gpt-5.4-mini, gpt-5.6-terra, gpt-5-mini, gpt-4.1-mini in order.
OPENAI_TEXT_MODEL=

# Optional: Neon Postgres connection string. When set, people, settings, and
# history sync across devices. Vercel's Neon integration adds this for you.
DATABASE_URL=
